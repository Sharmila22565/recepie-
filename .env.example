# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example: mongodb://127.0.0.1:27017/recipeshare
# Example: mongodb+srv://username:password@cluster0.mongodb.net/recipeshare
# If left unset or local mongo is unreachable, RecipeShare automatically uses embedded in-memory MongoDB!
MONGODB_URI=

# JWT Secret for authentication session tokens
JWT_SECRET=recipeshare_super_secret_jwt_key_2026_production

# Optional Cloudinary Configuration (if using cloud image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
